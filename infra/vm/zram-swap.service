# ============================================================
# zram — swap comprimido em RAM (CRM Cibele Matozo — v3.2)
# Instalado na VM Oracle em /etc/systemd/system/zram-swap.service.
# A VM micro (~1 GB) travava a rede quando a RAM enchia e o kernel
# começava a paginar para o swap EM DISCO (I/O lento => thrash =>
# sshd/PocketBase sufocam). O zram cria um bloco de swap na própria
# RAM, comprimido com zstd (~3:1), com PRIORIDADE acima dos swapfiles
# de disco: as páginas vão primeiro para o zram (rápido) e só
# transbordam para o disco em último caso. Resultado: fim do thrash.
#
# Instalar/atualizar na VM:
#   scp -i ~/crm-key.key infra/vm/zram-swap.service opc@163.176.154.238:/tmp/
#   ssh ... 'sudo install -m0644 /tmp/zram-swap.service /etc/systemd/system/ \
#     && echo zram | sudo tee /etc/modules-load.d/zram.conf \
#     && sudo systemctl daemon-reload && sudo systemctl enable --now zram-swap'
# Conferir: swapon --show   (zram0 deve aparecer com PRIO 100)
# ============================================================
[Unit]
Description=zram compressed swap (CRM Cibele - v3.2)
Documentation=https://github.com/qqafabio/cibelematozofotografia
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/sbin/modprobe zram
ExecStart=/bin/sh -c 'swapoff /dev/zram0 2>/dev/null; echo 1 > /sys/block/zram0/reset 2>/dev/null; sleep 1; echo zstd > /sys/block/zram0/comp_algorithm; echo 1536M > /sys/block/zram0/disksize; mkswap /dev/zram0; swapon --priority 100 /dev/zram0'
ExecStop=/bin/sh -c 'swapoff /dev/zram0; echo 1 > /sys/block/zram0/reset'

[Install]
WantedBy=multi-user.target
